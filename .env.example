# =====================================================================
# SETU — environment configuration TEMPLATE
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Every value here is a safe placeholder or a working default.
# =====================================================================

# ---- Application ----------------------------------------------------
APP_NAME=SETU
APP_ENV=development
# Base URL used to build public tracking links and officer magic links.
PUBLIC_BASE_URL=http://localhost:8000
# Secret used to sign officer action tokens (HMAC-SHA256). CHANGE THIS.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-please

# ---- Database -------------------------------------------------------
# SQLite by default (zero setup). PostgreSQL works with the same code:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/setu
DATABASE_URL=sqlite:///./setu.db

# ---- LLM provider ---------------------------------------------------
# mock    -> fully offline deterministic provider (DEFAULT, no network)
# gateway -> BeyonData OpenAI-compatible Ollama gateway
# local   -> sentence-transformers embeddings (optional extra; see requirements-local.txt)
LLM_PROVIDER=mock

# ---- BeyonData gateway (only used when LLM_PROVIDER=gateway) ---------
OLLAMA_GATEWAY_BASE_URL=https://gateway.example.internal
# Auth scheme: bearer | header | query | none
OLLAMA_GATEWAY_AUTH_SCHEME=bearer
OLLAMA_GATEWAY_AUTH_HEADER=Authorization
OLLAMA_GATEWAY_API_KEY=your-gateway-api-key-here
OLLAMA_GATEWAY_CONNECT_TIMEOUT=10
OLLAMA_GATEWAY_READ_TIMEOUT=120
OLLAMA_GATEWAY_MAX_RETRIES=3
OLLAMA_GATEWAY_CIRCUIT_FAIL_THRESHOLD=5
OLLAMA_GATEWAY_CIRCUIT_RESET_SECONDS=60
# If the gateway is unreachable, transparently fall back to the mock provider.
LLM_FALLBACK_TO_MOCK=true

# ---- Model catalogue (overridable; defaults live in app/llm/catalogue.py) ----
EMBEDDING_MODEL=bge-m3:latest
ARBITER_MODEL=gemma4:12b
ARBITER_MODEL_XL=gemma4:31b
JSON_MODEL=mistral-small3.2:latest
RERANK_MODEL=dengcao/Qwen3-Reranker-8B:Q8_0
TRANSLATE_MODEL=translategemma:12b
VISION_MODEL=qwen2.5vl:7b

# ---- Email provider -------------------------------------------------
# console -> writes .eml + .html previews to outbox/ (DEFAULT, no account)
# smtp    -> real SMTP over STARTTLS (Gmail app password friendly)
EMAIL_PROVIDER=console
EMAIL_FROM=SETU Grievance Cell <no-reply@setu.local>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
# For Gmail use a 16-char App Password, NOT your account password.
SMTP_PASSWORD=your-app-password-here
SMTP_USE_TLS=true

# ---- Admin console (HTTP Basic) -------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=setu-admin

# ---- SLA / scheduling -----------------------------------------------
# Divides all SLA durations. 3600 => 72h elapses in 72s (live demo).
SLA_TIME_SCALE=1.0
# Scheduler sweep interval in seconds.
SLA_SWEEP_SECONDS=60
# Set false to disable the background scheduler (useful in tests).
SCHEDULER_ENABLED=true

# ---- Classification defaults (also runtime-editable in Admin > Settings) ----
CLASSIFY_ALPHA=0.45
CONFIDENCE_HIGH=0.62
MARGIN_MIN=0.15
OTHER_THRESHOLD=0.30
REVIEW_THRESHOLD=0.55
SEMANTIC_TEMPERATURE=0.07
DEDUPE_THRESHOLD=0.92
